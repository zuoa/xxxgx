---
import Base from '../../layouts/Base.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const title = '继续教育学分政策解读_杭州专业技术人员学习新干线';
const description = '杭州市与浙江省继续教育学分/学时政策解读专栏：学分制管理办法、省学时管理办法、自然科研2026新规，逐条讲解90学分构成、折算规则与职称申报的关系。';

const articles = [
  {
    href: '/zhengce/xuefen-guanli-banfa/',
    name: '杭州市继续教育学分制管理办法解读',
    desc: '学分构成、90/60/18年度底线、折算规则、登记与职称的关系，逐条讲解。',
    tag: '核心政策',
  },
  {
    href: '/zhengce/zhejiang-xueshi-banfa/',
    name: '浙江省继续教育学时管理办法解读（浙人社发〔2016〕63号）',
    desc: '省级学时底线与杭州市办法的对应关系，行业细则备案制度是怎么回事。',
    tag: '省级政策',
  },
  {
    href: '/zhengce/ziran-keyan-xingui/',
    name: '自然科研系列2026新规解读（浙科发才〔2026〕14号）',
    desc: '专业科目分A/B两类设上限，成果申报期延至90天，2026年5月10日施行。',
    tag: '2026新规',
  },
];
---

<Base title={title} description={description}>
  <nav aria-label="面包屑" class="mb-5 text-sm text-gray-500">
    <a href="/" class="hover:text-blue-600">首页</a><span class="mx-1.5">/</span>
    <span class="text-gray-800">政策解读</span>
  </nav>

  <h1 class="text-2xl font-bold text-gray-900 md:text-3xl">继续教育学分政策解读</h1>
  <p class="mt-2 max-w-3xl text-sm leading-7 text-gray-600">
    杭州专业技术人员继续教育学分制度的三个关键文件：市级学分制管理办法定规则，
    省级学时管理办法定框架，行业登记细则定操作。以下逐篇解读。
  </p>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {articles.map((a) => (
      <a href={a.href} class="group flex flex-col rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:border-blue-300 hover:shadow-md">
        <span class="w-fit rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700">{a.tag}</span>
        <h2 class="mt-3 font-bold leading-6 text-gray-900 group-hover:text-blue-700">{a.name}</h2>
        <p class="mt-2 flex-1 text-sm leading-6 text-gray-600">{a.desc}</p>
        <span class="mt-3 text-sm font-medium text-blue-600">阅读全文 →</span>
      </a>
    ))}
  </div>

  <div class="prose-content mt-10 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2>政策体系一图速览</h2>
    <table>
      <thead>
        <tr><th>层级</th><th>文件</th><th>核心内容</th></tr>
      </thead>
      <tbody>
        <tr>
          <td>省级框架</td>
          <td>浙人社发〔2016〕63号</td>
          <td>每年90学时（专业60 + 公需合计18）；行业细则报省厅备案</td>
        </tr>
        <tr>
          <td>市级规则</td>
          <td>杭州市学分制管理办法</td>
          <td>学分构成与折算、新干线登记、与职称申报挂钩</td>
        </tr>
        <tr>
          <td>行业细则</td>
          <td>各行业登记细则/年度评审通知</td>
          <td>各行业累计口径、登记平台、申报时间（各不相同）</td>
        </tr>
      </tbody>
    </table>
    <p>
      查自己行业的要求，请前往<a href="/#hangye">各行业系列学分要求</a>；
      查学习平台，见<a href="/pingtai/">12个指定网络继续教育平台名单</a>。
    </p>
  </div>

  <CtaBanner />
</Base>
