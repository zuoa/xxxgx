---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaCard from '../../components/CtaCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config';

export async function getStaticPaths() {
  const entries = await getCollection('hangye');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const makeUp = {
  yes: {
    icon: 'check',
    text: '本系列明文允许集中补修学时',
    cls: 'border-green-200 bg-green-50 text-green-800',
    iconCls: 'text-green-600',
  },
  no: {
    icon: 'x',
    text: '本系列未明文允许集中补修',
    cls: 'border-red-200 bg-red-50 text-red-800',
    iconCls: 'text-red-500',
  },
  check: {
    icon: 'info',
    text: '是否可补修以本系列当年评审通知为准',
    cls: 'border-amber-200 bg-amber-50 text-amber-800',
    iconCls: 'text-amber-600',
  },
}[d.canMakeUp] as { icon: 'check' | 'x' | 'info'; text: string; cls: string; iconCls: string };

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: '行业要求', item: `${site.url}/#hangye` },
    { '@type': 'ListItem', position: 3, name: d.name, item: new URL(Astro.url.pathname, site.url).href },
  ],
};

const faqLd = d.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const jsonLd = faqLd ? [breadcrumbLd, faqLd] : [breadcrumbLd];

// 其他行业导航（侧边栏）
const others = (await getCollection('hangye'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title={d.title} description={d.description} jsonLd={jsonLd}>
  <!-- 面包屑 -->
  <nav aria-label="面包屑" class="mb-5 text-sm text-gray-500">
    <a href="/" class="hover:text-blue-600">首页</a>
    <span class="mx-1.5">/</span>
    <a href="/#hangye" class="hover:text-blue-600">行业要求</a>
    <span class="mx-1.5">/</span>
    <span class="text-gray-800">{d.name}</span>
  </nav>

  <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
    <!-- 正文 -->
    <article class="min-w-0 rounded-xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
      <h1 class="text-2xl font-bold leading-snug text-gray-900 md:text-3xl">
        杭州{d.name}系列继续教育学分要求（2026）
      </h1>
      <p class="mt-2 text-sm text-gray-500">评审级别：{d.level} · 内容更新：{d.updatedAt}</p>

      <!-- 学分要求速览 -->
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-blue-200 bg-blue-50 p-4">
          <p class="text-xs font-semibold text-blue-700">学分要求</p>
          <p class="mt-1 font-bold leading-6 text-gray-900">{d.creditRule}</p>
          {d.creditNote && <p class="mt-1 text-sm leading-6 text-gray-600">{d.creditNote}</p>}
        </div>
        <div class="rounded-lg border border-green-200 bg-green-50 p-4">
          <p class="text-xs font-semibold text-green-700">学分登记路径</p>
          <ul class="mt-1 space-y-1 text-sm font-medium text-gray-800">
            {d.registerPath.map((p) => <li>· {p}</li>)}
          </ul>
        </div>
        {d.applyWindow && (
          <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
            <p class="text-xs font-semibold text-amber-700">申报时间</p>
            <p class="mt-1 text-sm font-bold text-gray-900">{d.applyWindow}</p>
          </div>
        )}
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <p class="text-xs font-semibold text-gray-600">补修政策</p>
          <p class:list={['mt-2 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold', makeUp.cls]}>
            <Icon name={makeUp.icon} class:list={['h-3.5 w-3.5 shrink-0', makeUp.iconCls]} />
            {makeUp.text}
          </p>
        </div>
      </div>

      <!-- 正文 -->
      <div class="prose-content mt-4">
        <Content />
      </div>

      <!-- 主管部门联系方式 -->
      {d.contacts.length > 0 && (
        <section class="mt-8 rounded-lg border border-gray-200 bg-gray-50 p-4">
          <h2 class="text-base font-bold text-gray-900">主管部门咨询方式</h2>
          <ul class="mt-2 space-y-1 text-sm text-gray-700">
            {d.contacts.map((c) => (
              <li><span class="text-gray-500">{c.label}：</span><strong>{c.value}</strong></li>
            ))}
          </ul>
        </section>
      )}

      <!-- 行业 FAQ -->
      {d.faqs.length > 0 && (
        <section class="mt-10">
          <h2 class="border-l-4 border-blue-600 pl-3 text-xl font-bold text-gray-900">
            {d.name}系列常见问题
          </h2>
          <div class="mt-4 divide-y divide-gray-200 rounded-lg border border-gray-200">
            {d.faqs.map((f) => (
              <details class="group px-4 py-3">
                <summary class="flex cursor-pointer list-none items-center gap-2 font-medium text-gray-900 marker:hidden group-open:text-blue-700">
                  <Icon name="chevron" class="h-4 w-4 shrink-0 text-gray-400 transition group-open:rotate-90 group-open:text-blue-600" />
                  {f.q}
                </summary>
                <p class="mt-2 pl-6 text-sm leading-7 text-gray-700">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- 官方来源 -->
      <section class="mt-10">
        <h2 class="border-l-4 border-blue-600 pl-3 text-xl font-bold text-gray-900">官方来源</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {d.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener nofollow" class="inline-flex items-center gap-1 text-blue-600 hover:underline">
                {s.title}
                <Icon name="external" class="h-3.5 w-3.5 shrink-0" />
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs leading-5 text-gray-500">
          以上为本系列公开政策信息整理，最新要求以主管部门当年正式评审通知为准。
        </p>
      </section>

      <CtaBanner />
    </article>

    <!-- 侧栏 -->
    <div class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <CtaCard context={`${d.name}系列学分规划`} />
      <nav class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
        <p class="text-sm font-bold text-gray-900">其他行业学分要求</p>
        <ul class="mt-2 grid grid-cols-2 gap-1 lg:grid-cols-1">
          {others.map((o) => (
            <li>
              <a
                href={`/hangye/${o.id}/`}
                class="block rounded px-2 py-1.5 text-sm text-gray-600 hover:bg-blue-50 hover:text-blue-700"
              >
                {o.data.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</Base>
