---
import { site, cities } from '../config';
import Icon from '../components/Icon.astro';
import CitySwitcher from '../components/CitySwitcher.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 供 JSON-LD 注入的结构化数据对象（可多个） */
  jsonLd?: object | object[];
}

const { title, description, jsonLd } = Astro.props;
const fullTitle = `${title}_${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = `${site.url}/og-image.png`;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页', active: path === '/' },
  { href: '/hangye/jianshe-gongcheng/', label: '行业要求', active: path.startsWith('/hangye') },
  { href: '/zhengce/', label: '政策解读', active: path.startsWith('/zhengce') },
  { href: '/pingtai/', label: '12平台名单', active: path.startsWith('/pingtai') },
  { href: '/xuefenguize/', label: '学分折算', active: path.startsWith('/xuefenguize') },
  { href: '/faq/', label: '常见问题', active: path.startsWith('/faq') },
];

const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%232850d8'/><text x='32' y='43' font-size='32' font-family='sans-serif' font-weight='bold' fill='white' text-anchor='middle'>职</text></svg>";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index,follow" />
    <meta name="baidu-site-verification" content="codeva-8tfuGUUgkl" />
    <meta name="msvalidate.01" content="03BD7C8BEB631D9E94673789A2B4FA81" />
    <link rel="icon" href={favicon} />
    {jsonLdList.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50 text-gray-900 antialiased">
    <!-- 顶部品牌渐变条 -->
    <div class="h-1 bg-gradient-to-r from-blue-700 via-indigo-500 to-blue-500"></div>

    <header class="sticky top-0 z-40 border-b border-gray-200/80 bg-white/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex shrink-0 items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-blue-600 to-indigo-600 text-base font-bold text-white shadow-md shadow-blue-200">
            职
          </span>
          <span class="leading-tight">
            <span class="block text-base font-bold tracking-tight text-gray-900">{site.name}</span>
            <span class="hidden text-[11px] text-gray-500 sm:block">杭州站 · 90 / 60 / 18 学分要求一站查</span>
          </span>
        </a>
        <CitySwitcher />
        <nav class="hidden items-center gap-1 md:flex">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                item.active
                  ? 'bg-blue-50 text-blue-700'
                  : 'text-gray-600 hover:bg-gray-100 hover:text-blue-700',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <a
          href="#cta"
          class="shrink-0 rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-blue-200 transition hover:shadow-lg hover:brightness-110"
        >
          学分咨询
        </a>
      </div>
      <nav class="flex gap-1 overflow-x-auto border-t border-gray-100 px-4 py-1.5 md:hidden">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'shrink-0 rounded-md px-2.5 py-1 text-xs font-medium',
              item.active ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:text-blue-700',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400">
      <div class="mx-auto max-w-6xl px-4 py-10">
        <div class="grid gap-10 md:grid-cols-[1.2fr_1fr_1fr_1.2fr]">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-blue-500 to-indigo-500 text-sm font-bold text-white">
                职
              </span>
              <p class="font-bold text-white">{site.name}</p>
            </div>
            <p class="mt-3 max-w-sm text-sm leading-6">{site.tagline}</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">城市站点</p>
            <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
              {cities.map((city) => (
                <li class="flex items-center gap-1.5">
                  {city.open ? (
                    <>
                      <a href="/" class="text-blue-400 transition hover:text-blue-300">{city.name}站</a>
                      <span class="rounded bg-emerald-500/15 px-1.5 py-0.5 text-[10px] text-emerald-400">已开通</span>
                    </>
                  ) : (
                    <>
                      <span class="text-slate-500">{city.name}站</span>
                      <span class="rounded bg-slate-800 px-1.5 py-0.5 text-[10px] text-slate-500">筹备中</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">微信咨询</p>
            <img src={site.contact.qrImage} alt="微信咨询二维码" class="mt-3 w-28 rounded-lg bg-white p-1.5" loading="lazy" />
            <p class="mt-2 text-xs text-slate-500">扫码添加，备注"学分"</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">官方平台</p>
            <ul class="mt-3 space-y-2.5 text-sm">
              <li>
                <a href="https://learning.hzrs.hangzhou.gov.cn/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-blue-400 transition hover:text-blue-300">
                  杭州市专业技术人员学习新干线
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              </li>
              <li>
                <a href="https://zjjx.rlsbt.zj.gov.cn/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-blue-400 transition hover:text-blue-300">
                  浙江省继续教育学时登记管理系统
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              </li>
              <li>
                <a href="https://zcps.rlsbt.zj.gov.cn/" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-blue-400 transition hover:text-blue-300">
                  浙江省职称申报评审平台
                  <Icon name="external" class="h-3.5 w-3.5" />
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-slate-800 pt-5 text-xs leading-5 text-slate-500">
          <p>
            本站为继续教育学分政策信息整理与学习辅助服务网站，内容整理自杭州市人社局、浙江省人社厅等公开发布的政策文件，
            最新要求以各行业主管部门当年评审通知为准。内容更新：{site.updatedAt}
          </p>
          <p class="mt-1">© 2026 {site.name} · zcsb123.com</p>
        </div>
      </div>
    </footer>
  </body>
</html>
