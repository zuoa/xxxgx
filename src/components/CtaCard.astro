---
import { site } from '../config';

interface Props {
  /** 上下文提示语，如行业名 */
  context?: string;
}
const { context } = Astro.props;
const c = site.contact;
---

<!-- 侧栏 CTA 卡片（桌面端 sticky，移动端随文档流）；锚点 id 在 CtaBanner 上 -->
<aside class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-blue-600 to-indigo-700 p-5 text-white shadow-lg shadow-blue-200">
  <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-white/10"></div>
  <div class="absolute -bottom-12 -left-8 h-28 w-28 rounded-full bg-white/5"></div>
  <div class="relative">
    <p class="text-lg font-bold">{c.ctaTitle}</p>
    <p class="mt-2 text-sm leading-6 text-blue-100">
      {context ? `${context}：${c.ctaSubtitle}` : c.ctaSubtitle}
    </p>
    <img src={c.qrImage} alt="微信咨询二维码" class="mx-auto mt-4 w-40 rounded-xl bg-white p-2 shadow" loading="lazy" />
    <p class="mt-3 text-center text-xs text-blue-200">微信扫码咨询，添加请备注"学分"</p>
  </div>
</aside>
