---
import { site } from '../config';
const c = site.contact;
---

<!-- 页面底部通栏 CTA 横幅 -->
<div id="cta" class="relative mt-12 scroll-mt-24 overflow-hidden rounded-2xl bg-slate-900 p-6 text-center text-white shadow-xl md:p-10">
  <div class="absolute inset-0 bg-gradient-to-r from-blue-900/70 via-slate-900 to-indigo-900/70"></div>
  <div class="absolute -top-24 left-1/2 h-48 w-[28rem] -translate-x-1/2 rounded-full bg-blue-500/20 blur-3xl"></div>
  <div class="absolute -bottom-24 right-10 h-40 w-40 rounded-full bg-indigo-500/20 blur-3xl"></div>
  <div class="relative">
    <p class="text-xl font-bold md:text-2xl">{c.ctaTitle}</p>
    <p class="mx-auto mt-2 max-w-2xl text-sm leading-6 text-slate-300 md:text-base">{c.ctaSubtitle}</p>
    <img src={c.qrImage} alt="微信咨询二维码" class="mx-auto mt-6 w-32 rounded-xl bg-white p-2 shadow-lg md:w-36" loading="lazy" />
    <p class="mt-3 text-xs text-slate-400">微信扫码咨询，添加请备注"学分"</p>
  </div>
</div>
