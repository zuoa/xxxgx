---
/**
 * 全站统一 SVG 图标（stroke 风格，currentColor 着色）
 * 用法：<Icon name="chat" class="h-4 w-4" />
 */
interface Props {
  name:
    | 'cap'        // 学士帽（品牌）
    | 'chat'       // 对话（微信）
    | 'phone'      // 电话
    | 'arrowRight' // 右箭头
    | 'external'   // 外链
    | 'warning'    // 警告
    | 'check'      // 允许 / 通过
    | 'x'          // 不允许
    | 'info'       // 提示 / 待确认
    | 'chevron'    // 折叠箭头
    | 'doc'        // 文件 / 政策
    | 'bolt'       // 新规
    | 'globe'      // 平台 / 网址
    | 'calc';      // 折算 / 计算
  class?: string;
}
const { name, class: cls = 'h-5 w-5' } = Astro.props;
---

